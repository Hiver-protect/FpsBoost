@echo off
setlocal EnableDelayedExpansion
title FPS Boost - Assistant d'Installation Pro
cd /d "%~dp0"
set "INSTALLER_DP0=%~dp0"

echo.
echo  ==============================================================
echo   FPS Boost v3.0 Pro - Installeur Securise et Anti-Blocage
echo  ==============================================================
echo.

:: 1. Verifie si elevated, sinon tente l'elevation doucement sans bloquer
set "IS_ADMIN=0"
net session >nul 2>&1
if %errorlevel% equ 0 (
    set "IS_ADMIN=1"
) else (
    if /i "%~1" NEQ "__user" if /i "%~1" NEQ "__elevated" (
        powershell -NoProfile -ExecutionPolicy Bypass -Command "try { Start-Process cmd.exe -ArgumentList '/c \"\"%~f0\" __elevated\"' -Verb RunAs } catch { Start-Process cmd.exe -ArgumentList '/c \"\"%~f0\" __user\"' }"
        exit /b
    )
)

:: 2. Deblocage de tous les fichiers (Zone.Identifier Mark of the Web)
echo [1/3] Deblocage des fichiers telecharges...
powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-ChildItem -LiteralPath '%~dp0' -Recurse -File -ErrorAction SilentlyContinue | Unblock-File -ErrorAction SilentlyContinue"

:: 3. Nettoyage de tout ancien package WindowsApps bloque
echo [2/3] Nettoyage et desinstallation des anciens packages...
powershell -NoProfile -ExecutionPolicy Bypass -Command "try { Get-AppxPackage -Name '*LvFpsBoost*' -ErrorAction SilentlyContinue | Remove-AppxPackage -ErrorAction SilentlyContinue } catch {}"

:: 4. Deploiement Local Standalone WebView2 Natif, Raccourcis Bureau & Lancement
echo [3/3] Deploiement de FPS Boost Pro et creation des raccourcis...
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 

echo.
echo  ==============================================================
echo   INSTALLATION REUSSIE ! Lancement automatique de FPS Boost...
echo  ==============================================================
echo.

ping 127.0.0.1 -n 3 >nul
exit /b 0
